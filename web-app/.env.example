# Copy this file to web-app/.env and fill in the values. Never commit .env.
# On a host (Streamlit Community Cloud) put the same names in its Secrets settings instead.

# --- Gemini (optional: without a key the app runs on rules alone) ---
# Shipping documents can be sensitive, so Gemini is opt-in.
GEMINI_AI_ENABLED=true
# Create a key in Google AI Studio. Leave empty until you have one.
GEMINI_API_KEY=
# Optional. Run `python scripts/check_gemini.py` to list the model ids your key can use.
GEMINI_MODEL=
# Optional backups if the main model is overloaded (503). Blank = built-in defaults, "none" = no backups.
GEMINI_FALLBACK_MODELS=

# --- Firebase / Firestore (optional) ---
FIREBASE_ENABLED=true
# Local: path to the service-account JSON (default: web-app/serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json
# Hosted: paste the service-account JSON itself (or its base64) instead of using a file
FIREBASE_SERVICE_ACCOUNT_JSON=
