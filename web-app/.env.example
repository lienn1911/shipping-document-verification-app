# Gemini is opt-in because shipping documents can contain sensitive data.
GEMINI_AI_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key-heregit add .
GEMINI_MODEL=gemini-3.6-flash

# Optional: defaults to web-app/serviceAccountKey.json when enabled.
FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json
